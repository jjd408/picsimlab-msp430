include ../VERSION

PKG ?= "native"

OBJS = ppicsimlab.o picsimlab1.o picsimlab2.o picsimlab3.o picsimlab4.o picsimlab5.o picsimlab6.o 

OBJS+= $(patsubst lib/%.cc,lib/%.o,$(wildcard lib/*.cc)) 
OBJS+= $(patsubst sim_backend/%.cc,sim_backend/%.o,$(wildcard sim_backend/bsim*.cc)) 
OBJS+= $(patsubst boards/%.cc,boards/%.o,$(wildcard boards/board*.cc)) 
OBJS+= sim_backend/bridge_gpsim.o
OBJS+= $(patsubst sim_backend/msp430/%.cc,sim_backend/msp430/%.o,$(wildcard sim_backend/msp430/*.cc))
OBJS+= $(patsubst sim_backend/msp430/%.c,sim_backend/msp430/%.o,$(wildcard sim_backend/msp430/*.c))
OBJS+= $(patsubst devices/%.cc,devices/%.o,$(filter-out devices/prog_psp.cc,$(wildcard devices/*.cc)))
OBJS+= $(patsubst parts/%.cc,parts/%.o,$(wildcard parts/input*.cc))
OBJS+= $(patsubst parts/%.cc,parts/%.o,$(wildcard parts/output*.cc))
OBJS+= $(patsubst parts/%.cc,parts/%.o,$(wildcard parts/virtual*.cc))
OBJS+= $(patsubst parts/%.cc,parts/%.o,$(wildcard parts/other*.cc))

OBJS_EXP= $(patsubst boards/%.cc,boards/%.o,$(wildcard boards/exp_*.cc)) 
OBJS_EXP+= $(patsubst parts/%.cc,parts/%.o,$(wildcard parts/exp_*.cc)) 

.DEFAULT_GOAL := all

.PHONY: exp 

exp: OBJS+=$(OBJS_EXP)  
exp: EFLAGS=-D_EXPERIMENTAL_ 
#exp: rebuild
exp: $(OBJS_EXP)  all

rebuild:
	rm -rf picsimlab

override CXXFLAGS+= $(EFLAGS) -DEXT_BROWSER_EXAMPLES -DLEGACY081 -D_PKG_=\"${PKG}\"


sim_backend/bridge_gpsim.o: sim_backend/bridge_gpsim.cc
	@echo "Compiling $<"
	@$(CXX) $(CXXFLAGS)  $(PKG_CONFIG)  sim_backend/bridge_gpsim.cc  -c -o sim_backend/bridge_gpsim.o 


# The MSP430 CPU core is C (from MSPDebug)
sim_backend/msp430/%.o: sim_backend/msp430/%.c
	@echo "Compiling $<"
	@$(CC) -c -O2 -Wall $< -o $@

# The MSP430 backend and boards include the chip model's headers, which change its object layout:
# rebuild them when the headers change (this Makefile doesn't track header dependencies otherwise).
MSP430_HEADERS = $(wildcard sim_backend/msp430/*.h) sim_backend/bsim_msp430.h
sim_backend/bsim_msp430.o $(patsubst %.cc,%.o,$(wildcard sim_backend/msp430/*.cc)): $(MSP430_HEADERS)
$(patsubst %.cc,%.o,$(wildcard boards/board_MSP430*.cc) boards/board_Solitaire.cc): $(MSP430_HEADERS) devices/lcd_ls013b7dh05.h
